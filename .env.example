# Skopiuj ten plik jako .env i uzupełnij wartości

# Baza danych MySQL (dane z cPanel → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=twoj_uzytkownik_bazy
DB_PASS=twoje_haslo_bazy
DB_NAME=twoja_nazwa_bazy

# Opcjonalny PIN dostępu do aplikacji (zostaw puste = brak ochrony)
PIN=

# Port (Phusion Passenger na cPanel ignoruje tę wartość – nie zmieniaj)
PORT=3000
